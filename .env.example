# Copy to .env.local and fill in.
OPENROUTER_API_KEY=
MUNSIT_API_KEY=

# Optional overrides (defaults are baked into the API routes).
OPENROUTER_STORY_MODEL=google/gemini-2.5-pro
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Munsit voice & model. Default is "Arwa" — a warm female fusha
# (Modern Standard Arabic) voice that suits kids' storybook narration.
# Other Arabic voices: GET https://api.munsit.com/api/v1/voices
MUNSIT_VOICE_ID=OUOdy43qiHKwzVLRScXFnUe8
MUNSIT_MODEL_ID=faseeh-v1-preview
